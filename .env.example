OLLAMA_API_URL=http://localhost:11434
MODEL=llama3.1:8b
EMBEDDINGS_MODEL=nomic-embed-text:latest
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional
# INDEX_DIR=indexes              # where knowledge bases are saved
# NUM_CTX_MAX=16384              # upper bound for the LLM context window
# MAX_CONTEXTUAL_CHUNKS=300      # cap on Contextual Retrieval LLM calls per upload
